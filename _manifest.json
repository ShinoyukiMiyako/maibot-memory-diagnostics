{
  "manifest_version": 2,
  "id": "shinoyuki.memdiag",
  "version": "0.1.1",
  "name": "内存诊断",
  "description": "从进程外周期采集 Worker 内存、cgroup、WebUI 连接队列、主库只读统计与关键文件大小，写入插件数据目录；/memdiag 回复摘要，/memdiag pack 生成诊断包",
  "author": {
    "name": "ShinoyukiMiyako",
    "url": "https://github.com/ShinoyukiMiyako"
  },
  "license": "GPL-3.0-or-later",
  "urls": {
    "repository": "https://github.com/ShinoyukiMiyako/maibot-memory-diagnostics",
    "issues": "https://github.com/ShinoyukiMiyako/maibot-memory-diagnostics/issues"
  },
  "host_application": {
    "min_version": "1.2.3",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.8.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "send.text",
    "config.get"
  ],
  "i18n": {
    "default_locale": "zh-CN"
  }
}
